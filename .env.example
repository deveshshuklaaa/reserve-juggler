# ==============================================================================
# RESERVE JUGGLER - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
# NEVER commit the actual .env file containing real secrets to version control.
# ==============================================================================

ENVIRONMENT=development

# --- PostgreSQL Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=reserve_juggler
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reserve_juggler

# --- Backend Service ---
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# --- Frontend Client ---
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# --- Treasury & Decision Engine Configuration ---
BASE_SAFETY_BUFFER=50000.00
UNCERTAINTY_MULTIPLIER=1.96
MIN_SWEEP_THRESHOLD=10000.00
SWEEP_TARGET_EXCESS_RATIO=1.05

# --- Simulation & Forecasting Configuration ---
SIMULATION_SCENARIO=baseline
FORECAST_HORIZON_MINUTES=60
TRANSACTION_STREAM_SPEED_MS=1000

# Organizer historical source; relative paths resolve from the repository root.
ORGANIZER_DATASET_PATH=treasury_4tier_dataset.csv
